# Copy to .env for local development. Every variable has a sane default except the two secrets.
# The server validates this at boot and refuses to start with a readable error if something's wrong.

# --- Required ---------------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Local: `npm run db:up` starts pgvector on 5433. Hosted: Render/Neon/Supabase URL (pgvector needed).
DATABASE_URL=postgres://acme:acme@localhost:5433/acme_support

# --- Runtime ----------------------------------------------------------------------------------
# PORT=8080
# LOG_LEVEL=info
# Dev only: the Next dev server on :3000 calls the API on :8080.
CORS_ORIGINS=http://localhost:3000
# Hugging Face Spaces renders the app in an iframe on huggingface.co — allow-list it there.
# FRAME_ANCESTORS=https://huggingface.co
# DATABASE_SSL=auto            # auto | require | disable
# AI_PROVIDER=openai           # `fake` = fully offline deterministic models (tests/CI)

# --- Models (OpenAI) --------------------------------------------------------------------------
# OPENAI_CHAT_MODEL=gpt-5.4-mini
# OPENAI_FALLBACK_CHAT_MODEL=gpt-4.1-mini   # different family = independent failure domain
# OPENAI_REASONING_EFFORT=low               # none | minimal | low | medium | high
# OPENAI_JUDGE_MODEL=gpt-5.4-mini
# OPENAI_JUDGE_REASONING_EFFORT=low
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TRANSCRIBE_MODEL=gpt-live-transcribe
# OPENAI_TRANSCRIBE_DELAY=low
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin

# --- Guardrails (calibrated with `npm run eval:retrieval`) -------------------------------------
# RAG_TOP_K=4
# RAG_MIN_SIMILARITY=0.3          # hard floor on top-1 cosine similarity
# RAG_SIMILARITY_CEILING=0.62     # similarity at which the signal saturates
# RAG_LOW_CONFIDENCE=0.42         # below → refuse + escalate to a human
# RAG_HIGH_CONFIDENCE=0.7         # at/above → skip the answerability judge
# RAG_JUDGE_ENABLED=true

# --- Resilience -------------------------------------------------------------------------------
# LLM_FIRST_TOKEN_TIMEOUT_MS=15000
# LLM_MAX_RETRIES=2
# TOOL_TIMEOUT_MS=8000
# TOOL_MAX_ATTEMPTS=2
# AGENT_MAX_STEPS=8
# TURN_DEADLINE_MS=90000

# --- Abuse & cost protection ------------------------------------------------------------------
# DAILY_BUDGET_USD=5              # global spend cap per UTC day; 0 disables
# RATE_LIMIT_CHAT_PER_MIN=20
# RATE_LIMIT_SESSIONS_PER_HOUR=40
# VOICE_MAX_CONCURRENT_PER_IP=2
# VOICE_MAX_SESSION_MINUTES=15
# SESSION_TURN_LIMIT=80

# --- Voice activity detection -----------------------------------------------------------------
# VAD_END_SILENCE_MS=750          # endpointing pause
# VAD_BARGE_IN_MS=320             # sustained speech needed to interrupt the agent
# VAD_MIN_UTTERANCE_MS=250
# VAD_START_FRAMES=4

# --- Demo features ----------------------------------------------------------------------------
# ENABLE_CHAOS=true               # failure-injection panel in the observability drawer
# AUTO_MIGRATE=true
# AUTO_INGEST=true
